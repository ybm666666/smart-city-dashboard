# ===== 接口地址 =====
# 开发环境走 vite 的 proxy（见 vite.config.ts），这里用相对路径即可
VITE_API_BASE_URL=/api

# ===== 数据层（Day7）=====
# 是否使用内置 Mock 数据：默认 true（无后端也能跑）。
# 接入真实后端后设为 false，请求会走 VITE_API_BASE_URL。
VITE_USE_MOCK=true
# Mock 场景，用于本地预览三态：normal（正常）| empty（空态）| error（错误态）
VITE_MOCK_SCENARIO=normal

# ===== 大模型（OpenAI 兼容接口）=====
# 换成你自己的服务商；DeepSeek / 通义 / OpenAI 兼容地址都行
VITE_LLM_BASE_URL=https://api.deepseek.com/v1
# 把 sk-xxx 换成你自己的 Key（真实 Key 写在 .env.local，别提交到 Git）
VITE_LLM_API_KEY=sk-your-key-here
VITE_LLM_MODEL=deepseek-chat
# Day8：AI 出图是否强制走内置 Mock。留空时按「是否配置了有效 Key」自动判断；
# 设为 true 可强制走 Mock（即使配了 Key），便于离线演示。
VITE_USE_MOCK_LLM=false
